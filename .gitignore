# Vite cache
.vite

# Python
venv/
__pycache__/
*.pyc

# Secrets - never commit these, real credentials live only in your local
# .env and in whichever host's environment variable settings (Cloud Run,
# Render, etc.)
.env

# SQLite database - local dev data only; production uses Neon (Postgres),
# and this file regenerates itself automatically on first run anyway
app.db

# Locally-stored PDFs - only used as a fallback when R2 env vars aren't
# set (see backend/storage.py); production PDFs live in Cloudflare R2, not
# in git
uploads/